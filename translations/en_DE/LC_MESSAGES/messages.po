msgid_plural "Successfully generated assignments for %(num)d participants!"
msgstr[0] "Zuteilung for %(num)d Teilnehmer is erfolgreich gemacht!"
msgstr[1] "Zuteilungen for %(num)d Teilnehmers are erfolgreich gemacht!"

msgid "Successfully registered!"
msgstr "You are angemeldet, super!"

