msgid "A participant cannot be excluded from themselves"
msgstr "A Teilnehmer can not exclude himself from himself selbst"

msgid "A participant email is required"
msgstr "We need the E-Mail from the Teilnehmer, otherwise geht nix"

msgid "A registered email is required"
msgstr "You must give a registred E-Mail-Adress"

msgid "Admin"
msgstr "Admin-Bereich"

msgid "Admin - Secret Santa Organizer"
msgstr "Admin - Wichtel Organizär"

msgid "Admin Login"
msgstr "Admin Einlogg"

msgid "Admin Panel"
msgstr "Admin Panäl"

msgid "Admin Panel - Generate Assignments"
msgstr "Admin Panäl - Make the Auslosung"

msgid "Admin Password:"
msgstr "Admin Passwort, the secret one:"

msgid "An error occurred. Please try again."
msgstr "Oh no, there is a Fehler. Please try it again nochmal."

msgid "Assignment exclusions must be a list"
msgstr "The Ausschlüsse must be a List, sorry"

msgid "Assignment exclusions must refer to registered participants"
msgstr "Ausschlüsse must show on registred Teilnehmers"

msgid "Assignment found but giftee not found"
msgstr "Zuteilung is found, but the Beschenkte is weg"

msgid "Assignments already exist! Generating new assignments will overwrite existing ones."
msgstr "Achtung, there are already Zuteilungen! When you make new ones, the old ones go kaputt."

msgid "Assignments have been generated!"
msgstr "The Zuteilungen are ready gemacht!"

msgid "Assignments have been made! Check your email or use the link above to view your assignment."
msgstr "The Auslosung is done! Look in your E-Mails or klick the Link up there for see your Zuteilung."

msgid "Authentication successful"
msgstr "You are now inside, sehr gut"

msgid "Back to Home"
msgstr "Back to the Startseite"

msgid "Check Your Assignment"
msgstr "Look your Zuteilung"

msgid "Click here to view your Secret Santa assignment"
msgstr "Klick here for see who you must beschenk"

msgid "Could not load preferences."
msgstr "The Einstellungen could not be loaded, schade."

msgid "Could not remove participant."
msgstr "We could not throw out the Teilnehmer."

#, python-format
msgid "Could not save exclusions: %(error)s"
msgstr "Could not speichern the Ausschlüsse: %(error)s"

msgid "Could not save preferences."
msgstr "Einstellungen could not be gespeichert."

msgid "Current Assignments"
msgstr "Actual Zuteilungen"

msgid "Each assignment exclusion must contain two participant emails"
msgstr "Every Ausschluss must have two E-Mails from Teilnehmers inside"

msgid "Email Notifications:"
msgstr "E-Mail Benachrichtigungs:"

msgid "Email configuration not set"
msgstr "The E-Mail is not konfiguriered"

msgid "Email is required"
msgstr "E-Mail is Pflicht, sorry"

msgid "Email sent successfully"
msgstr "E-Mail is gesendet, wunderbar"

msgid "Email:"
msgstr "E-Mail Adress:"

msgid "Enter your email to view your Secret Santa assignment:"
msgstr "Give your E-Mail in, then you see whom you beschenk:"

msgid "Enter your registered email to update your gift wishes and choose who you should not draw. Exclusions are one-way and apply the next time assignments are generated."
msgstr "Give your registred E-Mail in for change your Geschenkwünsche and choose who you will not ziehen. Ausschlüsse are only in one Richtung and count by the next Auslosung."

msgid "Excluded participants must be provided as a list"
msgstr "Excluded Teilnehmers must come as a List"

#, python-format
msgid "Failed to send email: %(error)s"
msgstr "E-Mail sending is schiefgegangen: %(error)s"

msgid "Generate Assignments"
msgstr "Make Zuteilungen"

msgid "Generating assignments..."
msgstr "Zuteilungen are made, moment please..."

#, python-format
msgid "Gift preferences can be at most %(max)d characters long"
msgstr "Your Wünsche can be maximal %(max)d Zeichen long, not more"

msgid "Gift preferences must be text"
msgstr "Wünsche must be Text, natürlich"

#, python-format
msgid ""
"Hello %(name)s!\n"
"\n"
"Your Secret Santa assignment has been made!\n"
"\n"
"You are gifting to: %(giftee)s"
msgstr ""
"Hallo %(name)s!\n"
"\n"
"The Wichtel Auslosung is gemacht!\n"
"\n"
"You become a Geschenk for: %(giftee)s"

