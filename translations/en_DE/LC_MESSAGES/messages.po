msgstr "Ungültig Ausschlüsse: %(error)s"

msgid "Invalid email format"
msgstr "This E-Mail is not korrekt formatted"

msgid "Invalid excluded participant"
msgstr "Ungültig excluded Teilnehmer"

msgid "Invalid password"
msgstr "Falsch Password, try again"

msgid "Invalid request"
msgstr "This Anfrage is kaputt"

msgid "Language"
msgstr "Sprach"

msgid "Load My Preferences"
msgstr "Load my Einstellungen"

msgid "Loading preferences..."
msgstr "Einstellungen are loading, wait a Moment..."

msgid "Logged out successfully"
msgstr "You are now ausgeloggt"

msgid "Logging in..."
msgstr "Einlogging..."

msgid "Login"
msgstr "Einloggen"

msgid "Logout"
msgstr "Rausloggen"

msgid "My Preferences"
msgstr "My Wünsche and Einstellungs"

msgid "My Secret Santa Assignment"
msgstr "My Wichtel Zuteilung"

msgid "Name and email are required"
msgstr "Name and E-Mail are Pflicht"

msgid "Name:"
msgstr "Name from you:"

msgid "Need at least 2 participants to generate assignments"
msgstr "We need minimum 2 Teilnehmers for make the Auslosung"

msgid "No assignment found for this email"
msgstr "For this E-Mail there is no Zuteilung, leider"

msgid "No gift wishes entered yet. Check back later!"
msgstr "There are still no Wünsche. Look later again!"

msgid "No participant found for this email"
msgstr "Nobody with this E-Mail is angemeldet"

msgid "No participants registered yet."
msgstr "Still nobody is angemeldet."

msgid "No valid assignments are possible with the current exclusions. Remove some exclusions and try again."
msgstr "With this Ausschlüsse no Auslosung is possible. Make some Ausschlüsse away and try it again."

msgid "Not authenticated. Please log in first."
msgstr "You are not eingeloggt. Please log first in."

msgid "Participant not found"
msgstr "Teilnehmer is not findable"

msgid "Participant removed. Generate assignments again to notify the remaining participants."
msgstr "Teilnehmer is rausgeworfen. Make new Zuteilungen so the rest Teilnehmers become a Bescheid."

msgid "People you do not want to be assigned:"
msgstr "Peoples you will not ziehen:"

msgid "Please avoid:"
msgstr "Please not this, bitte:"

#, python-format
msgid "Please avoid: %(dislikes)s"
msgstr "Please not this, bitte: %(dislikes)s"

msgid "Please enter the admin password to access the admin panel."
msgstr "Please give the Admin Passwort in for come in the Admin Panäl."

msgid "Register"
msgstr "Anmelden yourself"

msgid "Register for Secret Santa"
msgstr "Make mit by the Wichteln"

msgid "Registered Participants"
msgstr "Angemeldete Peoples"

msgid ""
"Remember to keep this secret! 🎁\n"
"\n"
"Happy gifting!"
msgstr ""
"Psst, tell it nobody! 🎁\n"
"\n"
"Much Spaß by the Schenking!"

msgid "Remove"
msgstr "Rauswerfen"

#, python-format
msgid "Remove %(email)s? This will clear current assignments."
msgstr "Really throw %(email)s out? Then the actual Zuteilungen are weg."

msgid "Removing a participant clears the current assignments. Generate new assignments afterward."
msgstr "When you throw a Teilnehmer out, the Zuteilungen go kaputt. Make new ones afterwards."

msgid "Removing participant..."
msgstr "Teilnehmer is rausgeworfen..."

msgid "Save Preferences"
msgstr "Einstellungen speichern"

msgid "Saving preferences..."
msgstr "Einstellungen are gespeichert..."

msgid "Secret Santa Organizer"
msgstr "Wichtel Organizär"

msgid "Select any participants you should not draw. This preference is one-way."
msgstr "Choose the Teilnehmers you will not ziehen. This is only in one Richtung."

msgid "Skip sending email notifications"
msgstr "Don't send the E-Mails, bitte"

msgid "Status"
msgstr "Statussss"

